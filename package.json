{
  "name": "toolbox",
  "productName": "ToolBox",
  "version": "1.3.0",
  "description": "个人本地数字资源中心（绿色便携版）",
  "author": "YX Studio",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:electron": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "electron-vite build && electron . --smoke",
    "smoke:wallpaper": "electron-vite build && electron . --smoke --smoke-wallpaper",
    "pack:portable": "electron-vite build && electron-builder --win portable --x64",
    "pack:setup": "electron-vite build && electron-builder --win nsis --x64",
    "pack:all": "electron-vite build && electron-builder --win --x64",
    "deploy:exe": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
