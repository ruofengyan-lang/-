{
  "name": "toolbox",
  "productName": "ToolBox",
  "version": "1.9.0",
  "description": "\u4e2a\u4eba\u672c\u5730\u6570\u5b57\u8d44\u6e90\u4e2d\u5fc3\uff08\u7eff\u8272\u4fbf\u643a\u7248\uff09",
  "author": "YX Studio",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:electron": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "electron-vite build && electron . --smoke",
    "smoke:wallpaper": "electron . --smoke-wallpaper",
    "pack:portable": "electron-builder --win portable",
    "pack:setup": "electron-builder --win nsis",
    "pack:all": "electron-builder --win portable nsis",
    "deploy:exe": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
